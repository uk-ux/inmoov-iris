#include <Arduino.h>
#line 1 "U:\\inmoov\\firmware\\eye_simple_calibrator_uno\\eye_simple_calibrator_uno.ino"
#include <Wire.h>

// Uno A4=SDA, A5=SCL. PCA9685 address 0x40.
// Commands at 115200 baud: 1 90, 2 90, 3 90, 4 90, and 0 for eye outputs off.
// Eye channels: 1->0, 2->1, 3->2, 4->3.
const uint8_t PCA = 0x40;
const uint8_t CH[4] = {0, 1, 2, 3};
const uint16_t MIN_US = 1300, MAX_US = 1700;
char line[12]; uint8_t count = 0;
bool connected = false;

bool writeReg(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(PCA); Wire.write(reg); Wire.write(value);
  return Wire.endTransmission() == 0;
}
bool writePWM(uint8_t channel, uint16_t ticks) {
  Wire.beginTransmission(PCA); Wire.write(0x06 + channel * 4);
  Wire.write((uint8_t)0); Wire.write((uint8_t)0);
  Wire.write((uint8_t)(ticks & 255)); Wire.write((uint8_t)(ticks >> 8));
  return Wire.endTransmission() == 0;
}
void offEyes() {
  for (uint8_t i=0;i<4;++i) writePWM(CH[i],4096);
}
void runCommand() {
  if (count==1 && line[0]=='0') { offEyes(); Serial.println(F("EYES OFF")); return; }
  if (!connected || count<3 || line[0]<'1' || line[0]>'4' || line[1]!=' ') return;
  uint8_t eye=line[0]-'1', p=2; int position=0; bool digit=false;
  while(p<count && line[p]>='0' && line[p]<='9') { digit=true; position=position*10+line[p++]-'0'; }
  while(p<count && line[p]==' ') ++p;
  if(!digit || p!=count || position>180) return;
  uint16_t us=MIN_US+(long)position*(MAX_US-MIN_US)/180;
  uint16_t ticks=((unsigned long)us*4096+10000)/20000;
  offEyes();
  if(!writePWM(CH[eye],ticks)) { Serial.println(F("PCA WRITE FAILED")); return; }
  Serial.print(F("Eye ")); Serial.print(eye+1); Serial.print(F(" CH"));
  Serial.print(CH[eye]); Serial.print(F(" position ")); Serial.print(position);
  Serial.print(F(" pulse ")); Serial.print(us); Serial.println(F(" us"));
}
void setup() {
  Serial.begin(115200); Wire.begin(); Wire.setClock(100000);
  delay(200);
  Wire.beginTransmission(PCA);
  uint8_t result=Wire.endTransmission();
  if(result!=0) {
    Serial.print(F("PCA NOT FOUND at 0x40, I2C status ")); Serial.println(result);
    return;
  }
  if(!writeReg(0x00,0x10)||!writeReg(0xFE,121)||!writeReg(0x00,0x20)||!writeReg(0x00,0xA0)) {
    Serial.println(F("PCA SETUP FAILED")); return;
  }
  offEyes(); connected=true;
  Serial.println(F("READY eye channels 0-3; outputs OFF"));
}
void loop() {
  while(Serial.available()) {
    char c=Serial.read();
    if(c=='\r'||c=='\n') { if(count) runCommand(); count=0; }
    else if(count<sizeof(line)) line[count++]=c;
    else count=0;
  }
}

