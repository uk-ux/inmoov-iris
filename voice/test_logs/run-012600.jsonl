{"phrase": "Do you like music?", "lang": "en", "audio_s": 1.09, "t_stt": 4.24, "stt_lang": "en", "t_llm": 2.9, "t_tts": 0.81, "audio_bytes": 210476, "heard": "Do you like music?", "reply": "I enjoy music! It helps me learn and understand different sounds and emotions.", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 7.95, "cycle": 1}
{"phrase": "Where do you live?", "lang": "en", "audio_s": 0.93, "t_stt": 5.29, "stt_lang": "en", "t_llm": 3.21, "t_tts": 1.42, "audio_bytes": 259628, "heard": "Where do you live?", "reply": "I don't live in a traditional sense, but I can help you find information or answer questions about places!", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 9.93, "cycle": 1}
{"phrase": "வணக்கம், நீங்கள் யார்?", "lang": "ta", "audio_s": 1.9, "t_stt": 4.48, "stt_lang": "ta", "t_llm": 10.92, "t_tts": 5.63, "audio_bytes": 489004, "heard": "வணக்கம் நீங்கள் யார்", "reply": "நான் இனமோவ், ஒரு பணி வேகம் மற்றும் தொலைமையான போன்ற பயனுள்ள போன்ற மாநில வெக்டர்களை உபயோகிக்க வேண்டும் ஒரு போன்ற வடிவியல் வெக்டர்களை உருவாக்குவதற்கான ஒரு வடிவியல் வெக்டர் ஆகுகிறேன். வணக்கம்!", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 21.04, "cycle": 1}
