{"phrase": "Can you move your eyes?", "lang": "en", "audio_s": 1.47, "t_stt": 3.18, "stt_lang": "en", "t_llm": 4.1, "t_tts": 1.64, "audio_bytes": 410156, "heard": "Can you move your eyes?", "reply": "I can move my eyes in various ways, similar to how you can move one eye while keeping the other still. It's a cool trick that takes some practice, just like for me!", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 8.92, "cycle": 1}
{"phrase": "Tell me something interesting about robots.", "lang": "en", "audio_s": 2.16, "t_stt": 3.19, "stt_lang": "en", "t_llm": 4.43, "t_tts": 3.61, "audio_bytes": 519212, "heard": "Tell me something interesting about robots.", "reply": "Robots are increasingly used in factories for speed and consistency. Interestingly, South Korea leads in robot density with 531 robots for every 10,000 people in manufacturing.", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 11.24, "cycle": 1}
{"phrase": "How are you feeling today?", "lang": "en", "audio_s": 1.5, "t_stt": 4.84, "stt_lang": "en", "t_llm": 5.88, "t_tts": 0.36, "audio_bytes": 94764, "heard": "How are you feeling today?", "reply": "I'm feeling great! How about you?", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 11.09, "cycle": 1}
