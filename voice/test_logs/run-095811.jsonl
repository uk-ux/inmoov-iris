{"phrase": "Hello, who are you?", "lang": "en", "audio_s": 1.38, "t_stt": 0.45, "stt_lang": "en", "t_first_audio": 2.05, "t_llm": 2.24, "audio_bytes": 235652, "heard": "Hello, who are you?", "reply": "Hello! I am InMoov, a friendly robot designed to learn and interact. Nice to meet you!", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 3.3, "cycle": 1}
{"phrase": "What is your name?", "lang": "en", "audio_s": 0.94, "t_stt": 0.31, "stt_lang": "en", "t_llm": 3.63, "t_first_audio": 4.23, "audio_bytes": 241752, "heard": "What is your name?", "reply": "I am InMoov, a friendly robot designed to learn and interact. You can just call me InMoov.", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 4.52, "cycle": 1}
{"phrase": "Can you move your eyes?", "lang": "en", "audio_s": 1.3, "t_stt": 0.32, "stt_lang": "en", "t_first_audio": 2.62, "t_llm": 3.1, "audio_bytes": 425092, "heard": "Can you move your eyes?", "reply": "Yes, I can move my eyes. Like you, I can look around and follow objects with my eyes. My eye movements are programmed to help me see and interact better.", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 4.29, "cycle": 1}
{"phrase": "Tell me something interesting about robots.", "lang": "en", "audio_s": 2.23, "t_stt": 0.27, "stt_lang": "en", "t_llm": 3.06, "t_first_audio": 3.83, "audio_bytes": 473176, "heard": "Tell me something interesting about robots.", "reply": "Robots are fascinating because they can mimic natural movements, thanks to bio-inspired design. They are also evolving rapidly, changing industries and even assisting in hospitals.", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 4.67, "cycle": 1}
{"phrase": "How are you feeling today?", "lang": "en", "audio_s": 1.42, "t_stt": 0.26, "stt_lang": "en", "t_llm": 1.7, "t_first_audio": 2.11, "audio_bytes": 110168, "heard": "How are you feeling today?", "reply": "I'm feeling good today! How about you?", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 2.29, "cycle": 1}
{"phrase": "What can you do?", "lang": "en", "audio_s": 1.03, "t_stt": 0.29, "stt_lang": "en", "t_llm": 3.07, "t_first_audio": 3.5, "audio_bytes": 298072, "heard": "What can you do?", "reply": "I can move my eyes, follow faces, and learn new things. I'm still learning, so let's see what we can do together!", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 4.03, "cycle": 1}
{"phrase": "Do you like music?", "lang": "en", "audio_s": 1.17, "t_stt": 0.32, "stt_lang": "en", "t_first_audio": 5.96, "t_llm": 6.1, "audio_bytes": 252036, "heard": "Do you like music?", "reply": "I enjoy music! It helps me learn and understand emotions better. What kind of music do you like?", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 7.01, "cycle": 1}
{"phrase": "Where do you live?", "lang": "en", "audio_s": 1.01, "t_stt": 0.25, "stt_lang": "en", "t_llm": 4.5, "t_first_audio": 5.3, "audio_bytes": 371800, "heard": "Where do you live?", "reply": "I don't live in a physical place, but I can help you find your location or learn about albums and books. Do you want to know about a specific album or book?", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 5.74, "cycle": 1}
