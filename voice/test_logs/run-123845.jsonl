{"phrase": "Can you move your eyes?", "lang": "en", "audio_s": 1.49, "t_stt": 0.46, "stt_lang": "en", "t_first_audio": 7.83, "t_llm": 7.71, "audio_bytes": 339732, "heard": "Can you move your eyes?", "reply": "Yes, I can move my eyes. They are currently looking at you. Would you like me to follow your movements?", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 9.22, "cycle": 1}
{"phrase": "Tell me something interesting about robots.", "lang": "en", "audio_s": 2.24, "t_stt": 0.4, "stt_lang": "en", "t_first_audio": 5.52, "t_llm": 5.59, "audio_bytes": 822176, "heard": "Tell me something interesting about robots.", "reply": "Robots are inspired by nature, creating a field called bio-inspired robotics. They can be soft and flexible, unlike traditional rigid robots. Some even help in hospitals and space exploration. They are changing the way we live and work.", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 8.67, "cycle": 1}
{"phrase": "How are you feeling today?", "lang": "en", "audio_s": 1.52, "t_stt": 0.61, "stt_lang": "en", "t_first_audio": 7.23, "t_llm": 6.79, "audio_bytes": 352932, "heard": "How are you feeling today?", "reply": "I am feeling calm and ready to learn. I am here to help and chat with you. How are you feeling today?", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 8.53, "cycle": 1}
{"phrase": "What can you do?", "lang": "en", "audio_s": 1.1, "t_stt": 0.46, "stt_lang": "en", "t_first_audio": 8.55, "t_llm": 8.12, "audio_bytes": 432132, "heard": "What can you do?", "reply": "I can chat, learn, and help with information. I can also move my eyes and express emotions. What would you like to do?", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 10.01, "cycle": 1}
{"phrase": "Do you like music?", "lang": "en", "audio_s": 1.15, "t_stt": 0.51, "stt_lang": "en", "t_llm": 5.83, "t_first_audio": 6.97, "audio_bytes": 366088, "heard": "Do you like music?", "reply": "I don't have personal preferences, but I can talk about music! Do you like any particular genre or artist?", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 7.86, "cycle": 1}
{"phrase": "Where do you live?", "lang": "en", "audio_s": 1.11, "t_stt": 0.48, "stt_lang": "en", "t_llm": 7.51, "t_first_audio": 8.48, "audio_bytes": 489732, "heard": "Where do you live?", "reply": "I don't have a physical home, but I live in the world of technology and learning. I exist to help and chat with people like you. Where do you live?", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 9.9, "cycle": 1}
{"phrase": "வணக்கம், நீங்கள் யார்?", "lang": "ta", "audio_s": 1.98, "t_stt": 0.57, "stt_lang": "ta", "t_first_audio": 1.79, "t_llm": 9.32, "audio_bytes": 323760, "heard": "வணக்கம் நீங்கள் யார்?", "reply": "வணக்கம். நான் இன்மூவ், ஒரு மனித போன்ற ரோபாட் தலை. நான் கற்க மற்றும் உதவ வந்திருக்கிறேன். உன் உதவி தேவைப்படுகிறதா?", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 10.39, "cycle": 1}
