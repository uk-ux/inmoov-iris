{"phrase": "Hello, who are you?", "lang": "en", "audio_s": 1.32, "t_stt": 0.48, "stt_lang": "en", "t_first_audio": 4.58, "t_llm": 5.51, "audio_bytes": 436976, "heard": "Hello, who are you?", "reply": "Hello. I am InMoov, a humanoid robot head. I am here to learn and help. How can I assist you today?", "stt_sim": 1.0, "lang_ok": true, "reply_lang_ok": true, "t_total": 7.18, "cycle": 1}
